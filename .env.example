# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Porta da API
PORT=3000

# Banco de dados PostgreSQL (roda na própria EC2)
DB_HOST=localhost
DB_PORT=5432
DB_USER=api_user
DB_PASSWORD=TROQUE_PELA_SENHA_DO_BANCO
DB_NAME=api_db

# Token de acesso da API (gere um com: openssl rand -hex 32)
API_TOKEN=TROQUE_PELO_SEU_TOKEN
